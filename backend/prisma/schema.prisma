generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  author    String?
  imageUrl  String?
  createdAt DateTime @default(now())

  cards     Card[]
}

model Card {
  id        Int      @id @default(autoincrement())
  message   String
  gifUrl    String
  author    String?
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())

  boardId   Int
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}